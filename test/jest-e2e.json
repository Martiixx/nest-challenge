{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapping": {
    "^src/(.*)$": "<rootDir>/../src/$1"
  },
  "setupFilesAfterEnv": ["<rootDir>/jest-setup.ts"],
  "testTimeout": 30000,
  "collectCoverageFrom": [
    "../src/**/*.(t|j)s",
    "!../src/main.ts",
    "!../src/**/*.spec.ts",
    "!../src/**/*.e2e-spec.ts"
  ]
}
